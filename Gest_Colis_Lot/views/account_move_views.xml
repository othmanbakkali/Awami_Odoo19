<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue Formulaire héritée : account.move -->
        <record id="view_move_form_inherit_gest_colis" model="ir.ui.view">
            <field name="name">account.move.form.inherit.gest.colis</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Champs liés au colis insérés avant le produit -->
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="before">
                    <field name="package_id" optional="show" string="Colis"/>
                    <field name="package_photo" widget="image" options="{'size': [32, 32]}" readonly="1" optional="show" string="Photo Colis"/>
                    <field name="package_product_ids" invisible="1"/>
                </xpath>
                <!-- Quantité dispo colis après le produit -->
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                    <field name="qty_available_colis" optional="show" string="Stock Colis"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
