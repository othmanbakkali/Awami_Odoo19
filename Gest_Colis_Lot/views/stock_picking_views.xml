<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue Formulaire héritée : stock.picking -->
        <record id="view_picking_form_inherit_gest_colis" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.gest.colis</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- En-tête : Informations du Colis Global -->
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="package_id" string="Colis Global"/>
                    <field name="package_photo" widget="image" options="{'size': [64, 64]}" class="oe_avatar" readonly="0"/>
                    <field name="package_supplier_ref" string="Réf Fournisseur Colis"/>
                    <field name="package_designation" string="Désignation Colis"/>
                </xpath>

                <!-- Lignes de mouvements de stock : Ajouter le Colis -->
                <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="before">
                    <field name="package_photo" widget="image" options="{'size': [32, 32]}" readonly="1" optional="show" string="Photo Colis"/>
                </xpath>
                
                <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
                    <field name="qty_available_colis" optional="show" string="Stock Colis"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
