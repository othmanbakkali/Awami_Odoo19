<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_gest_colis" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.gest.colis</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Champs liés au colis insérés avant le produit -->
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                    <field name="package_id" optional="show" string="Colis"/>
                    <field name="package_photo" widget="image" options="{'size': [32, 32]}" readonly="1" optional="show" string="Photo Colis"/>
                    <field name="package_product_ids" column_invisible="True"/>
                </xpath>
                <!-- Passer le colis dans le contexte pour filtrer côté serveur -->
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                    <attribute name="context">{'package_id': package_id}</attribute>
                </xpath>
                <!-- Champs liés au lot et quantité disponible insérés après le produit -->
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                    <field name="qty_available_colis" optional="show" string="Stock Colis"/>
                    <field name="lot_id" optional="show" context="{'default_product_id': product_id}" />
                    <field name="nb_pieces" optional="show"/>
                    <field name="longueur" optional="show"/>
                    <field name="longueur_totale" optional="show" string="Longueur Totale"/>
                    <field name="quantite_uv" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
