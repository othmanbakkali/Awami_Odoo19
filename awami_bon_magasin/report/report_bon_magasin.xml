<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action Rapport Bon Magasin -->
    <record id="action_report_bon_magasin" model="ir.actions.report">
        <field name="name">Bon Magasin</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">awami_bon_magasin.report_bon_magasin_template</field>
        <field name="report_file">awami_bon_magasin.report_bon_magasin_template</field>
        <field name="print_report_name">'Bon_Magasin_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template Document Bon Magasin -->
    <template id="report_bon_magasin_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #222;">
                <!-- En-tête Titre & Références -->
                <div class="row mb-4">
                    <div class="col-7">
                        <h2 style="font-size: 24px; font-weight: bold; color: #1e3a5f; margin-bottom: 5px;">
                            <span>Bon Magasin N° </span>
                            <span t-field="doc.name"/>
                        </h2>
                        <div style="font-size: 12px; color: #555;">
                            <strong>Date : </strong><span t-field="doc.date_order" t-options="{'widget': 'date'}"/><br/>
                            <t t-if="doc.user_id">
                                <strong>Vendeur : </strong><span t-field="doc.user_id.name"/><br/>
                            </t>
                            <t t-if="doc.payment_mode">
                                <strong>Mode de règlement : </strong><span t-field="doc.payment_mode"/><br/>
                                <t t-if="doc.check_number">
                                    <strong>N° de série : </strong><span t-field="doc.check_number"/><br/>
                                </t>
                                <t t-if="doc.check_client_name and doc.check_client_name != doc.partner_id.name">
                                    <strong>Nom émetteur : </strong><span t-field="doc.check_client_name"/><br/>
                                </t>
                                <t t-if="doc.check_date_due">
                                    <strong>Échéance : </strong><span t-field="doc.check_date_due" t-options="{'widget': 'date'}"/><br/>
                                </t>
                            </t>
                        </div>
                    </div>
                    <div class="col-5 text-end">
                        <div style="border: 1px solid #ddd; border-radius: 6px; padding: 10px; background-color: #fcfcfc;">
                            <strong style="color: #1e3a5f;">Client :</strong><br/>
                            <span style="font-weight: bold; font-size: 14px;" t-field="doc.partner_id.name"/><br/>
                            <t t-if="doc.partner_id.phone">Tél : <span t-field="doc.partner_id.phone"/><br/></t>
                            <t t-if="doc.partner_id.street"><span t-field="doc.partner_id.street"/><br/></t>
                            <t t-if="doc.partner_id.city"><span t-field="doc.partner_id.city"/></t>
                        </div>
                    </div>
                </div>

                <!-- Tableau des Lignes du Bon Magasin -->
                <table class="table table-sm table-striped mt-3" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #1e3a5f; color: #ffffff; text-align: left;">
                            <th style="padding: 7px; width: 45%;">Article / Description</th>
                            <th style="padding: 7px; text-align: right; width: 12%;">Quantité</th>
                            <th style="padding: 7px; text-align: center; width: 12%;">Unité</th>
                            <th style="padding: 7px; text-align: right; width: 15%;">Prix Unitaire</th>
                            <t t-if="any(line.discount for line in doc.order_line)">
                                <th style="padding: 7px; text-align: right; width: 8%;">Rem.%</th>
                            </t>
                            <th style="padding: 7px; text-align: right; width: 16%;">Sous-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line" t-as="line">
                            <t t-if="not line.display_type">
                                <tr style="border-bottom: 1px solid #e0e0e0;">
                                    <td style="padding: 6px;">
                                        <span t-field="line.name"/>
                                        <t t-if="line.is_m3 and line.wood_length">
                                            <div style="font-size: 11px; color: #1e3a5f; font-weight: bold; margin-top: 2px;">
                                                <span>Dim : </span>
                                                <span t-field="line.wood_length"/>m ×
                                                <span t-field="line.wood_width"/>m ×
                                                <span t-field="line.wood_thickness"/>m
                                                <t t-if="line.volume_m3">
                                                    <span> (= <span t-field="line.volume_m3"/> m³)</span>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="line.base_price_unit and line.product_uom_id and line.product_id and line.product_uom_id != line.product_id.uom_id">
                                            <div style="font-size: 11px; color: #555; margin-top: 2px;">
                                                <span>P.U Base : </span><span t-field="line.base_price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/> / <span t-field="line.product_id.uom_id.name"/>
                                            </div>
                                        </t>
                                    </td>
                                    <td style="padding: 6px; text-align: right;">
                                        <span t-field="line.product_uom_qty" t-options="{'widget': 'float', 'precision': 5}"/>
                                    </td>
                                    <td style="padding: 6px; text-align: center;">
                                        <span class="badge bg-light text-dark border" t-field="line.product_uom_id.name"/>
                                    </td>
                                    <td style="padding: 6px; text-align: right;">
                                        <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <t t-if="any(l.discount for l in doc.order_line)">
                                        <td style="padding: 6px; text-align: right;">
                                            <span t-if="line.discount" t-field="line.discount"/>
                                        </td>
                                    </t>
                                    <td style="padding: 6px; text-align: right; font-weight: bold;">
                                        <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-elif="line.display_type == 'line_section'">
                                <tr style="background-color: #f1f4f8; font-weight: bold;">
                                    <td colspan="99" style="padding: 6px;"><span t-field="line.name"/></td>
                                </tr>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <tr style="font-style: italic; color: #666;">
                                    <td colspan="99" style="padding: 4px;"><span t-field="line.name"/></td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <!-- Bloc Totaux -->
                <div class="row justify-content-end mt-3">
                    <div class="col-5">
                        <table class="table table-sm" style="border: none;">
                            <tr style="border-bottom: 1px solid #eee;">
                                <td><strong>Total HT</strong></td>
                                <td class="text-end">
                                    <span t-field="doc.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td><strong>TVA</strong></td>
                                <td class="text-end">
                                    <span t-field="doc.amount_tax" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="background-color: #1e3a5f; color: #ffffff; font-size: 15px; font-weight: bold;">
                                <td style="padding: 8px;">Total TTC</td>
                                <td class="text-end" style="padding: 8px;">
                                    <span t-field="doc.amount_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                            <t t-if="doc.payment_mode">
                                <tr style="font-size: 12px; color: #333; border-top: 1px solid #eee; background-color: #fdfdfd;">
                                    <td style="padding: 6px;">
                                        <strong>Mode de règlement :</strong> <span t-field="doc.payment_mode"/>
                                        <t t-if="doc.check_number">
                                            <span style="color: #666; font-size: 11px;"> (N° <span t-field="doc.check_number"/>)</span>
                                        </t>
                                    </td>
                                    <td class="text-end" style="padding: 6px; font-weight: bold;">
                                        <span t-field="doc.amount_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </table>
                    </div>
                </div>

                <!-- Signatures -->
                <div class="row mt-5 pt-3" style="border-top: 1px dashed #ccc; font-size: 12px;">
                    <div class="col-6 text-center">
                        <strong>Signature &amp; Cachet Magasin</strong>
                        <div style="height: 60px;"></div>
                    </div>
                    <div class="col-6 text-center">
                        <strong>Signature Client (Bon pour accord)</strong>
                        <div style="height: 60px;"></div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_bon_magasin_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="awami_bon_magasin.report_bon_magasin_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
