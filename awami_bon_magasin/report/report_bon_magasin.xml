<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action Rapport Bon Magasin Standard -->
    <record id="action_report_bon_magasin" model="ir.actions.report">
        <field name="name">Bon Magasin</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">awami_bon_magasin.report_bon_magasin_template</field>
        <field name="report_file">awami_bon_magasin.report_bon_magasin_template</field>
        <field name="print_report_name">'Bon_Magasin_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Action Rapport Bon Magasin A5 (2 Pages A5 : Client & Contrôle) -->
    <record id="action_report_bon_magasin_a5_2pages" model="ir.actions.report">
        <field name="name">Bon Magasin A5 (2 Copies : Client &amp; Contrôle)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">awami_bon_magasin.report_bon_magasin_a5_2pages_template</field>
        <field name="report_file">awami_bon_magasin.report_bon_magasin_a5_2pages_template</field>
        <field name="print_report_name">'Bon_Magasin_A5_2Copies_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="awami_bon_magasin.paperformat_a5_single"/>
    </record>

    <!-- Action Rapport Bon Magasin A5 (1 Seule Copie) -->
    <record id="action_report_bon_magasin_a5_single" model="ir.actions.report">
        <field name="name">Bon Magasin A5 (1 Seule Copie)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">awami_bon_magasin.report_bon_magasin_a5_single_template</field>
        <field name="report_file">awami_bon_magasin.report_bon_magasin_a5_single_template</field>
        <field name="print_report_name">'Bon_Magasin_A5_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="awami_bon_magasin.paperformat_a5_single"/>
    </record>

    <!-- Template Document Bon Magasin A5 Unitaire -->
    <template id="report_bon_magasin_single_bon">
        <meta charset="utf-8"/>
        <div style="font-family: DejaVu Sans, Arial, sans-serif; font-size: 12.5px; color: #2c1810; padding: 0; box-sizing: border-box;">
            <!-- 1. En-tête : Société à gauche, Client & Type de Copie à droite -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 5px;">
                <tr>
                    <td style="width: 52%; vertical-align: top;">
                        <table style="border-collapse: collapse;">
                            <tr>
                                <td t-if="doc.company_id.logo" style="vertical-align: top; padding-right: 10px;">
                                    <img t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 48px; max-width: 130px; object-fit: contain;" alt="Logo"/>
                                </td>
                                <td style="vertical-align: top;">
                                    <div style="font-weight: 800; font-size: 14px; color: #4a2c11; line-height: 1.15;" t-field="doc.company_id.name"/>
                                    <div style="font-size: 9.5px; color: #6b5744; margin-top: 2px; line-height: 1.35;">
                                        <div t-if="doc.company_id.street or doc.company_id.street2 or doc.company_id.city">
                                            <span t-if="doc.company_id.street"><t t-esc="doc.company_id.street"/><span t-if="doc.company_id.street2 or doc.company_id.city">, </span></span>
                                            <span t-if="doc.company_id.street2"><t t-esc="doc.company_id.street2"/><span t-if="doc.company_id.city">, </span></span>
                                            <span t-if="doc.company_id.city"><t t-esc="doc.company_id.city"/></span>
                                        </div>
                                        <div style="margin-top: 1px;">
                                            <span t-if="doc.company_id.phone">
                                                <strong>Tél :</strong> <span t-esc="doc.company_id.phone"/>
                                            </span>
                                            <span t-if="doc.company_id.phone and (doc.company_id.company_registry or doc.company_id.vat)"> &amp;nbsp;|&amp;nbsp; </span>
                                            <span t-if="doc.company_id.company_registry"><strong>ICE :</strong> <span t-field="doc.company_id.company_registry"/></span>
                                            <span t-elif="doc.company_id.vat"><strong>ICE :</strong> <span t-field="doc.company_id.vat"/></span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td style="width: 48%; vertical-align: top; text-align: right;">
                        <div style="font-size: 16px; font-weight: 800; color: #4a2c11; line-height: 1.2;">
                            <span t-field="doc.partner_id.name"/>
                        </div>
                        <t t-if="copy_label">
                            <div t-attf-style="display: inline-block; font-size: 11px; font-weight: 800; padding: 3px 9px; border-radius: 4px; margin-top: 3px; text-transform: uppercase; letter-spacing: 0.5px; #{'color: #543216; background-color: #f5ede3; border: 1.5px solid #c8ad93;' if 'CLIENT' in copy_label else 'color: #78350f; background-color: #fef3c7; border: 1.5px solid #fcd34d;'}">
                                <span t-out="copy_label"/>
                            </div>
                        </t>
                    </td>
                </tr>
            </table>

            <!-- 2. Titre du Bon Magasin & Statut -->
            <table style="width: 100%; border-collapse: collapse; margin: 4px 0 6px 0;">
                <tr>
                    <td style="vertical-align: middle; text-align: left;">
                        <span style="font-size: 17.5px; font-weight: 800; color: #4a2c11;">
                            <span>Bon Magasin N° </span>
                            <span t-field="doc.name"/>
                        </span>
                    </td>
                    <td style="vertical-align: middle; text-align: right;">
                        <span style="display: inline-block; padding: 3px 9px; font-size: 11px; font-weight: 800; border-radius: 4px; background-color: #f5ede3; color: #78350f; border: 1.5px solid #d7c4b1; text-transform: uppercase;">
                            <span t-if="doc.state in ('sale', 'done')">COMMANDE CONFIRMÉE</span>
                            <span t-elif="doc.state == 'draft'">DEVIS / BON MAGASIN</span>
                            <span t-elif="doc.state == 'cancel'">ANNULÉ</span>
                            <span t-else="" t-field="doc.state"/>
                        </span>
                    </td>
                </tr>
            </table>

            <!-- 3. Ligne d'informations / Métadonnées (Parchment Wood) -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px; font-size: 10.5px; line-height: 1.25; background-color: #faf6f0; border: 1.5px solid #d7c4b1; border-radius: 4px;">
                <tr>
                    <td style="width: 25%; padding: 4px 6px;">
                        <div style="font-weight: 800; color: #7c6a59; font-size: 9px; text-transform: uppercase;">Date Commande</div>
                        <div style="color: #3e2723; font-weight: 800; font-size: 11.5px;">
                            <span t-esc="doc.date_order.strftime('%d/%m/%Y') if doc.date_order else ''"/>
                        </div>
                    </td>
                    <td style="width: 25%; padding: 4px 6px;">
                        <div style="font-weight: 800; color: #7c6a59; font-size: 9px; text-transform: uppercase;">Vendeur</div>
                        <div style="color: #3e2723; font-weight: 800; font-size: 11.5px;">
                            <span t-if="doc.user_id" t-field="doc.user_id.name"/>
                            <span t-else="">-</span>
                        </div>
                    </td>
                    <td style="width: 25%; padding: 4px 6px;">
                        <div style="font-weight: 800; color: #7c6a59; font-size: 9px; text-transform: uppercase;">Référence Client</div>
                        <div style="color: #3e2723; font-weight: 800; font-size: 11.5px;">
                            <span t-if="doc.client_order_ref" t-field="doc.client_order_ref"/>
                            <span t-else="">-</span>
                        </div>
                    </td>
                    <td style="width: 25%; padding: 4px 6px;">
                        <div style="font-weight: 800; color: #7c6a59; font-size: 9px; text-transform: uppercase;">Téléphone Client</div>
                        <div style="color: #3e2723; font-weight: 800; font-size: 11.5px;">
                            <span t-if="doc.partner_id.phone" t-field="doc.partner_id.phone"/>
                            <span t-else="">-</span>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- 4. Tableau des Articles avec Prix Unitaire et P.U Base Clairement Affichés -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px; font-size: 12px;">
                <thead>
                    <tr style="border-bottom: 2.5px solid #543216; background-color: #f5ede3;">
                        <th style="padding: 5px 6px; text-align: left; font-weight: 800; color: #4a2c11; width: 42%; font-size: 12.5px;">Désignation</th>
                        <th style="padding: 5px 6px; text-align: right; font-weight: 800; color: #4a2c11; width: 18%; font-size: 12.5px;">Quantité</th>
                        <th style="padding: 5px 6px; text-align: right; font-weight: 800; color: #4a2c11; width: 20%; font-size: 12.5px; white-space: nowrap;">Prix Unitaire</th>
                        <th style="padding: 5px 6px; text-align: right; font-weight: 800; color: #4a2c11; width: 20%; font-size: 12.5px; white-space: nowrap;">Montant</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.order_line" t-as="line">
                        <t t-if="not line.display_type">
                            <tr style="border-bottom: 1px solid #e7ded5;">
                                <!-- Désignation de l'article -->
                                <td style="padding: 4.5px 6px; vertical-align: top; text-align: left;">
                                    <div style="color: #2c1810; font-weight: 800; font-size: 12.5px; line-height: 1.25;">
                                        <span t-if="line.product_id" t-field="line.product_id.name"/>
                                        <span t-else="" t-field="line.name"/>
                                    </div>
                                    <t t-if="line.product_id and line.name and line.name != line.product_id.name">
                                        <div style="font-size: 10.5px; color: #6b5744; margin-top: 1px;" t-field="line.name"/>
                                    </t>
                                    <t t-if="not line.is_adjustment_line and (line.is_m3 or (line.wood_length and line.wood_width))">
                                        <div style="font-size: 11px; color: #854d0e; font-weight: 800; margin-top: 1.5px;">
                                            Dim : <span t-field="line.wood_length"/>m × <span t-field="line.wood_width"/>m × <span t-field="line.wood_thickness"/>m
                                            <t t-if="line.volume_m3">
                                                <span> (= <span t-field="line.volume_m3"/> m³)</span>
                                            </t>
                                        </div>
                                    </t>
                                </td>

                                <!-- Quantité -->
                                <td style="padding: 4.5px 6px; vertical-align: top; text-align: right;">
                                    <div style="font-weight: 800; color: #2c1810; font-size: 12.5px;">
                                        <span t-if="line.is_adjustment_line">-</span>
                                        <span t-elif="line.is_m3 or line.wood_length" t-esc="'%.5f' % line.product_uom_qty"/>
                                        <span t-else="" t-esc="'%.2f' % line.product_uom_qty"/> <span t-if="not line.is_adjustment_line" t-field="line.product_uom_id.name" style="font-size: 10.5px; font-weight: 700; color: #6b5744;"/>
                                    </div>
                                    <t t-if="not line.is_adjustment_line and line.product_id and line.product_uom_id and line.product_uom_id != line.product_id.uom_id">
                                        <t t-set="uom_ratio" t-value="line.product_uom_id.factor / (line.product_id.uom_id.factor or 1.0) if line.product_uom_id.factor else 1.0"/>
                                        <t t-if="uom_ratio &gt; 1.0">
                                            <div style="font-size: 10px; color: #7c6a59; font-weight: 600; margin-top: 1px;">
                                                (= <span t-esc="'%.2f' % (line.product_uom_qty * uom_ratio)"/> <span t-field="line.product_id.uom_id.name"/>)
                                            </div>
                                        </t>
                                    </t>
                                </td>

                                <!-- PRIX UNITAIRE & P.U BASE CLAIREMENT AFFICHÉS -->
                                <td style="padding: 4.5px 6px; vertical-align: top; text-align: right; white-space: nowrap;">
                                    <div style="font-weight: 800; color: #4a2c11; font-size: 13px;">
                                        <span t-esc="'%.2f' % line.price_unit"/> <span style="font-size: 10px; font-weight: 600; color: #6b5744;">DH</span>
                                    </div>
                                    <t t-if="line.base_price_unit and not line.is_adjustment_line">
                                        <t t-if="abs(line.base_price_unit - line.price_unit) &gt; 0.001">
                                            <div style="font-size: 11px; color: #854d0e; font-weight: 800; margin-top: 2px;">
                                                P.U Base : <span t-esc="'%.2f' % line.base_price_unit"/> DH<t t-if="line.product_id and line.product_id.uom_id and line.product_id.uom_id != line.product_uom_id"> / <span t-field="line.product_id.uom_id.name"/></t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div style="font-size: 10px; color: #7c6a59; font-weight: 700; margin-top: 1px;">
                                                P.U Base : <span t-esc="'%.2f' % line.base_price_unit"/> DH
                                            </div>
                                        </t>
                                    </t>
                                </td>

                                <!-- Montant -->
                                <td style="padding: 4.5px 6px; vertical-align: top; text-align: right; font-weight: 800; color: #4a2c11; font-size: 13.5px; white-space: nowrap;">
                                    <span t-esc="'%.2f' % line.price_subtotal"/> <span t-field="doc.currency_id.symbol" style="font-size: 10.5px; font-weight: 600; color: #6b5744;"/>
                                </td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_section'">
                            <tr style="background-color: #f5ede3; font-weight: 800; color: #4a2c11;">
                                <td colspan="4" style="padding: 6px;"><span t-field="line.name"/></td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <tr style="font-style: italic; color: #7c6a59;">
                                <td colspan="4" style="padding: 4px;"><span t-field="line.name"/></td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- 5. Bas de page : Mode de Règlement à gauche, Bloc TOTAL à droite -->
            <table style="width: 100%; border-collapse: collapse; margin-top: 6px; font-size: 11px; border-top: 2.5px solid #543216; padding-top: 5px;">
                <tr>
                    <td style="width: 48%; vertical-align: top; padding-right: 8px;">
                        <div style="color: #2c1810; font-size: 12px; font-weight: 800;">
                            Bon Magasin : <strong style="color: #543216;"><span t-field="doc.name"/></strong>
                        </div>
                        <t t-if="doc.payment_mode">
                            <div style="font-size: 11px; color: #6b5744; margin-top: 3px; line-height: 1.4;">
                                Mode de règlement : <strong style="color: #4a2c11; font-size: 11.5px;"><span t-field="doc.payment_mode"/></strong>
                                <t t-if="doc.check_number">
                                    <br/>N° série / Chèque : <strong style="color: #4a2c11; font-size: 11.5px;"><span t-field="doc.check_number"/></strong>
                                </t>
                                <t t-if="doc.check_client_name and doc.check_client_name != doc.partner_id.name">
                                    <br/>Émetteur : <strong style="color: #4a2c11; font-size: 11.5px;"><span t-field="doc.check_client_name"/></strong>
                                </t>
                                <t t-if="doc.check_date_due">
                                    <br/>Échéance : <strong style="color: #4a2c11; font-size: 11.5px;"><span t-field="doc.check_date_due" t-options="{'widget': 'date'}"/></strong>
                                </t>
                            </div>
                        </t>
                    </td>
                    <td style="width: 52%; vertical-align: top;">
                        <table style="width: 100%; border-collapse: collapse; border: 2px solid #543216; background-color: #ffffff;">
                            <tr style="background-color: #543216; color: #ffffff;">
                                <td style="padding: 5px 8px; font-weight: 800; font-size: 13px; text-transform: uppercase;">
                                    TOTAL TTC
                                </td>
                                <td style="padding: 5px 8px; font-weight: 900; font-size: 16.5px; text-align: right; white-space: nowrap;">
                                    <span t-esc="'%.2f' % doc.amount_total"/> <span t-field="doc.currency_id.symbol"/>
                                </td>
                            </tr>
                            <tr style="color: #4a2c11; font-size: 11px; border-bottom: 1px dashed #d7c4b1; background-color: #faf6f0;">
                                <td style="padding: 3px 8px; text-align: left; font-weight: 700;">Total HT</td>
                                <td style="padding: 3px 8px; text-align: right; font-weight: 800;">
                                    <span t-esc="'%.2f' % doc.amount_untaxed"/> <span t-field="doc.currency_id.symbol"/>
                                </td>
                            </tr>
                            <tr t-if="doc.amount_tax" style="color: #4a2c11; font-size: 11px; background-color: #faf6f0;">
                                <td style="padding: 3px 8px; text-align: left; font-weight: 700;">TVA</td>
                                <td style="padding: 3px 8px; text-align: right; font-weight: 800;">
                                    <span t-esc="'%.2f' % doc.amount_tax"/> <span t-field="doc.currency_id.symbol"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- Signatures -->
            <div style="margin-top: 15px; padding-top: 6px; border-top: 1px dashed #c8ad93; font-size: 11px;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td style="width: 50%; text-align: center; vertical-align: top;">
                            <strong style="color: #543216;">Signature &amp; Cachet Magasin</strong>
                            <div style="height: 35px;"></div>
                        </td>
                        <td style="width: 50%; text-align: center; vertical-align: top;">
                            <strong style="color: #543216;">Signature Client (Bon pour accord)</strong>
                            <div style="height: 35px;"></div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </template>

    <!-- Template Bon Magasin Standard (A4/A5 compatible) -->
    <template id="report_bon_magasin_template">
        <t t-call="web.html_container">
            <meta charset="utf-8"/>
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: DejaVu Sans, Arial, sans-serif; width: 100%; box-sizing: border-box; padding: 0; margin: 0;">
                    <t t-set="copy_label" t-value="''"/>
                    <t t-call="awami_bon_magasin.report_bon_magasin_single_bon"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Template Bon Magasin 2 Pages A5 (Page 1 = Client, Page 2 = Contrôle) -->
    <template id="report_bon_magasin_a5_2pages_template">
        <t t-call="web.html_container">
            <meta charset="utf-8"/>
            <t t-foreach="docs" t-as="doc">
                <!-- 1. PREMIÈRE PAGE A5 VERTICAL : COPIE CLIENT -->
                <div class="page" style="font-family: DejaVu Sans, Arial, sans-serif; width: 100%; box-sizing: border-box; padding: 0; margin: 0; page-break-after: always; page-break-inside: avoid;">
                    <t t-set="copy_label" t-value="'(COPIE CLIENT)'"/>
                    <t t-call="awami_bon_magasin.report_bon_magasin_single_bon"/>
                </div>

                <!-- 2. DEUXIÈME PAGE A5 VERTICAL : COPIE CONTRÔLE -->
                <div class="page" t-att-style="'font-family: DejaVu Sans, Arial, sans-serif; width: 100%; box-sizing: border-box; padding: 0; margin: 0; page-break-inside: avoid;' + (' page-break-after: always;' if not doc_last else ' page-break-after: avoid;')">
                    <t t-set="copy_label" t-value="'(COPIE CONTRÔLE)'"/>
                    <t t-call="awami_bon_magasin.report_bon_magasin_single_bon"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Template Bon Magasin A5 Single -->
    <template id="report_bon_magasin_a5_single_template">
        <t t-call="web.html_container">
            <meta charset="utf-8"/>
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: DejaVu Sans, Arial, sans-serif; width: 100%; box-sizing: border-box; padding: 0; margin: 0;">
                    <t t-set="copy_label" t-value="''"/>
                    <t t-call="awami_bon_magasin.report_bon_magasin_single_bon"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
