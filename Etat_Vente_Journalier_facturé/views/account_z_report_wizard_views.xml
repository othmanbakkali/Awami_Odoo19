<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_z_report_wizard_form" model="ir.ui.view">
        <field name="name">account.z.report.wizard.form</field>
        <field name="model">account.z.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer Rapport Z / X Journalier">
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="report_type" widget="radio"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="salesperson_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="invoice_state"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" string="Générer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_z_report_wizard" model="ir.actions.act_window">
        <field name="name">Générer Rapport Z Journalier</field>
        <field name="res_model">account.z.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
