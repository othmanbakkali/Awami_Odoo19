<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_account_z_report" model="report.paperformat">
        <field name="name">Format A4 Rapport Z</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_z" model="ir.actions.report">
        <field name="name">Rapport Z / X Journalier</field>
        <field name="model">account.z.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">etat_vente_journalier_facture.report_z_document_template</field>
        <field name="report_file">etat_vente_journalier_facture.report_z_document_template</field>
        <field name="print_report_name">'Rapport_%s' % (object.name.replace('/', '_'))</field>
        <field name="binding_model_id" ref="model_account_z_report"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_account_z_report"/>
    </record>
</odoo>

