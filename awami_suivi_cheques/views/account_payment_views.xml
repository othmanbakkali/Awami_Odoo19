<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Héritage Formulaire account.payment -->
    <record id="view_account_payment_form_inherit_suivi_cheque" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.suivi.cheque</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Smart button Suivi du Chèque dans la button box -->
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_view_check_tracking" type="object" class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="not check_tracking_id and payment_mode not in ('cheque', 'effet', 'traite', 'effet_cheque') and not check_number">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Suivi</span>
                        <span class="o_stat_text">Chèque / Effet</span>
                    </div>
                </button>
            </xpath>

            <!-- Ajout des champs Banque et Statut Chèque dans les infos chèque -->
            <xpath expr="//field[@name='check_date_due']" position="after">
                <field name="bank_name" placeholder="Ex: Attijariwafa, BCP, CIH..."
                       invisible="payment_mode not in ('cheque', 'effet', 'traite', 'effet_cheque') and not check_number"/>
                <field name="check_state" widget="badge" string="Statut Suivi Chèque"
                       decoration-success="check_state == 'paye'"
                       decoration-danger="check_state == 'impaye'"
                       decoration-warning="check_state == 'retour_banque'"
                       decoration-info="check_state == 'depose'"
                       decoration-muted="check_state == 'en_caisse'"
                       invisible="not check_state"/>
                <field name="check_tracking_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Héritage Liste account.payment -->
    <record id="view_account_payment_tree_inherit_suivi_cheque" model="ir.ui.view">
        <field name="name">account.payment.list.inherit.suivi.cheque</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="check_state" string="Statut Chèque" widget="badge" optional="show"
                       decoration-success="check_state == 'paye'"
                       decoration-danger="check_state == 'impaye'"
                       decoration-warning="check_state == 'retour_banque'"
                       decoration-info="check_state == 'depose'"
                       decoration-muted="check_state == 'en_caisse'"/>
            </xpath>
        </field>
    </record>

    <!-- Héritage Wizard Enregistrement de Paiement (account.payment.register) -->
    <record id="view_account_payment_register_form_inherit_suivi_cheque" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.suivi.cheque</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_date_due']" position="after">
                <field name="bank_name" placeholder="Ex: Attijariwafa, BCP, BMCE, CIH..."
                       invisible="payment_mode not in ('cheque', 'effet', 'traite', 'effet_cheque')"/>
            </xpath>
        </field>
    </record>

</odoo>

