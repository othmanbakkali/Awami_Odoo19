<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Isolation stricte par enseigne (société active) pour le Suivi des Chèques & Effets -->
        <record id="suivi_cheque_comp_rule" model="ir.rule">
            <field name="name">Suivi des Chèques et Effets multi-société</field>
            <field name="model_id" ref="model_suivi_cheque"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>

