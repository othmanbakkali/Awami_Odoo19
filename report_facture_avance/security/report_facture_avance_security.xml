<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Isolation stricte par enseigne (société active) pour le Suivi Factures & Avances -->
        <record id="report_facture_avance_comp_rule" model="ir.rule">
            <field name="name">Suivi Factures et Avances multi-société</field>
            <field name="model_id" ref="model_report_facture_avance"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>

