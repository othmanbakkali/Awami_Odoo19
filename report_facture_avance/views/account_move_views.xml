<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_report_avance" model="ir.ui.view">
        <field name="name">account.move.form.inherit.report.avance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="is_report_hidden" string="Masquer dans Suivi Avances"/>
            </xpath>
        </field>
    </record>
</odoo>

